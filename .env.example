# ─── TNR Solutions — Environment Variables ───────────────────────────────────
# Copy this file to .env and fill in your values.
# All vars prefixed with VITE_ are available at runtime via import.meta.env.
# See src/config/env.ts for runtime validation & typed access.

# ── Site ─────────────────────────────────────────────────────────────────────
VITE_SITE_URL=https://tnrsolutions.co.in

# ── API (add when a backend endpoint is introduced) ──────────────────────────
# VITE_API_URL=https://api.tnrsolutions.co.in/v1
# VITE_API_KEY=your-api-key

# ── Contact / Webhook (optional — for server-side form handling) ────────────
# VITE_FORM_ENDPOINT=https://your-endpoint.com/submit
